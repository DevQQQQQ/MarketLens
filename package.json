                "type": "A_SHARE"
              },
              {
                "symbol": "sh603686",
                "name": "福龙马",
                "type": "A_SHARE"
              },
              {
                "symbol": "sz002867",
                "name": "周大生",
                "type": "A_SHARE"
              },
              {
                "symbol": "sh603031",
                "name": "安孚科技",
                "type": "A_SHARE"
              },
              {
                "symbol": "sh601988",
                "name": "中国银行",
                "type": "A_SHARE"
              },
              {
                "symbol": "sh603019",
                "name": "中科曙光",
                "type": "A_SHARE"
              },
              {
                "symbol": "sz000977",
                "name": "浪潮信息",
                "type": "A_SHARE"
              },
              {
                "symbol": "sh688545",
