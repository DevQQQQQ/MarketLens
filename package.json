              }
            ],
            "Alpha": [
              {
                "symbol": "0x73b84f7e3901f39fc29f3704a03126d317ab4444",
                "name": "PUP",
                "type": "ALPHA_TOKEN"
              }
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "package": "vsce package --allow-missing-repository --allow-star-activation --no-dependencies",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.7"
  }
}