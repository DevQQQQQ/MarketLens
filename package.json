{
	"name": "marketlens",
	"displayName": "MarketLens - 全球行情看板 (A股/港股/美股/加密货币)",
	"description": "专为开发者打造的行情看板与效率工具，实时查看 A股、港股、美股、主流加密货币、DEX 资产，支持快捷键隐藏、简洁模式及网络代理配置。",
	"version": "1.1.3",
	"publisher": "devqqqqq",
	"repository": {
		"type": "git",
		"url": "https://github.com/DevQQQQQ/MarketLens"
	},
	"bugs": {
		"url": "https://github.com/DevQQQQQ/MarketLens/issues"
	},
	"homepage": "https://github.com/DevQQQQQ/MarketLens",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "assets/icon.png",
	"categories": [
		"Other",
		"Visualization"
	],
	"keywords": [
		"A股",
		"港股美股",
		"行情看板",
		"Binance",
		"Crypto"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "marketlens-container",
					"title": "MarketLens",
					"icon": "assets/icon.svg"
				}
			]
		},
		"views": {
			"marketlens-container": [
				{
					"id": "marketlens.watchlist",
					"name": "MarketLens",
					"icon": "assets/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "marketlens.refresh",
				"title": "立即刷新全部",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.refreshGroup",
				"title": "刷新当前分类",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.toggleMask",
				"title": "切换简洁展示模式",
				"icon": "$(eye)"
			},
			{
				"command": "marketlens.toggleBossKey",
				"title": "专注模式（一键隐藏/恢复）",
				"icon": "$(eye-closed)"
			},
			{
				"command": "marketlens.addItem",
				"title": "添加自选",
				"icon": "$(add)"
			},
			{
				"command": "marketlens.removeItem",
				"title": "删除",
				"icon": "$(trash)"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"title": "切换颜色脱敏模式",
				"icon": "$(paintcan)"
			},
			{
				"command": "marketlens.openKeybindings",
				"title": "自定义快捷键",
				"icon": "$(keyboard)"
			},
			{
				"command": "marketlens.openSettings",
				"title": "设置",
				"icon": "$(gear)"
			},
			{
				"command": "marketlens.restoreDefaults",
				"title": "恢复出厂默认设置",
				"icon": "$(discard)"
			},
			{
				"command": "marketlens.clearWatchlist",
				"title": "一键清空自选标的",
				"icon": "$(clear-all)"
			},
			{
				"command": "marketlens.pinToTop",
				"title": "置顶",
				"icon": "$(pin)"
			}
		],
		"keybindings": [
			{
				"command": "marketlens.toggleBossKey",
				"key": "ctrl+alt+m",
				"win": "ctrl+alt+m",
				"mac": "cmd+alt+m"
			},
			{
				"command": "marketlens.toggleBossKey",
				"key": "alt+m",
				"win": "alt+m",
				"mac": "alt+m"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "ctrl+alt+k",
				"win": "ctrl+alt+k",
				"mac": "cmd+alt+k"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "alt+k",
				"win": "alt+k",
				"mac": "alt+k"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "ctrl+alt+l",
				"win": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "alt+l",
				"win": "alt+l",
				"mac": "alt+l"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "marketlens.openSettings",
					"when": "view == marketlens.watchlist",
					"group": "navigation@1"
				},
				{
					"command": "marketlens.refresh",
					"when": "view == marketlens.watchlist",
					"group": "navigation@2"
				},
				{
					"command": "marketlens.toggleBossKey",
					"when": "view == marketlens.watchlist",
					"group": "navigation@3"
				},
				{
					"command": "marketlens.toggleMask",
					"when": "view == marketlens.watchlist",
					"group": "navigation@4"
				},
				{
					"command": "marketlens.addItem",
					"when": "view == marketlens.watchlist",
					"group": "navigation@5"
				}
			],
			"view/item/context": [
				{
					"command": "marketlens.refreshGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "inline"
				},
				{
					"command": "marketlens.pinToTop",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@1"
				},
				{
					"command": "marketlens.removeItem",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@2"
				}
			]
		},
		"configuration": {
			"title": "MarketLens",
			"properties": {
				"marketlens.autoRefresh": {
					"type": "boolean",
					"default": true,
					"order": 1,
					"description": "【全局】是否开启定时自动刷新（取消勾选则不自动刷新，仅在手动点击刷新按钮时更新）"
				},
				"marketlens.refreshInterval": {
					"type": "number",
					"default": 5000,
					"minimum": 1000,
					"maximum": 300000,
					"order": 2,
					"description": "【全局】定时刷新间隔（毫秒），如 5000 表示 5 秒"
				},
				"marketlens.maskMode": {
					"type": "boolean",
					"default": false,
					"order": 3,
					"description": "【全局】紧凑展示模式：将行情数据展示为简洁构建信息格式"
				},
				"marketlens.colorNeutral": {
					"type": "boolean",
					"default": false,
					"order": 4,
					"description": "【全局】中性色彩模式：关闭红绿色彩标记，使用编辑器默认主题文本颜色"
				},
				"marketlens.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"order": 5,
					"description": "【全局】全部标的参与底部轮播：是否在底部状态栏轮播展示行情（关闭后彻底隐藏底部状态栏）"
				},
				"marketlens.proxyPort": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"default": 10808,
					"order": 6,
					"description": "【全局】本地代理端口号（1-65535，如 v2rayN 10808/10809, Clash 7890/7897 等）"
				},
				"marketlens.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 7,
					"description": "【全局】统一代理地址（仅支持 HTTP / 混合代理，自动由代理端口生成）"
				},
				"marketlens.aShare.enabled": {
					"type": "boolean",
					"default": true,
					"order": 10,
					"description": "【A股板块】是否启用 A 股市场行情（取消勾选则在自选列表中隐藏 A 股）"
				},
				"marketlens.aShare.networkMode": {
					"type": "string",
					"enum": [
						"direct",
						"proxy"
					],
					"enumDescriptions": [
						"直连访问（默认，腾讯接口境内推荐直连，零延迟）",
						"强制走代理"
					],
					"default": "direct",
					"order": 11,
					"description": "【A股板块】网络访问模式：direct (直连，默认) 或 proxy (走代理)"
				},
				"marketlens.aShare.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 12,
					"description": "【A股板块】代理地址"
				},
				"marketlens.aShare.stopOnMarketClosed": {
					"type": "boolean",
					"default": true,
					"order": 13,
					"description": "【A股板块】闭市期间停止轮询（开启后仅在 A 股交易时段 9:15-11:30, 13:00-15:05 请求数据）"
				},
				"marketlens.aShare.statusBar": {
					"type": "boolean",
					"default": true,
					"order": 14,
					"description": "【A股板块】A股标的是否参与底部状态栏轮播"
				},
				"marketlens.hkStock.enabled": {
					"type": "boolean",
