{
  "name": "marketlens",
  "displayName": "MarketLens - A股与加密货币行情看板",
  "description": "专为开发者打造的行情看板与效率工具，实时查看 A股、主流加密货币、DEX 资产，支持快捷键隐藏、简洁模式及网络代理配置。",
  "version": "1.0.0",
  "publisher": "devqqqqq",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevQQQQQ/MarketLens"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "assets/icon.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "A股",
    "股票",
    "行情看板",
    "Binance",
    "Crypto"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marketlens-container",
          "title": "MarketLens",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "marketlens-container": [
        {
          "id": "marketlens.watchlist",
          "name": "MarketLens",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "marketlens.refresh",
        "title": "立即刷新全部",
        "icon": "$(refresh)"
      },
      {
        "command": "marketlens.refreshGroup",
        "title": "刷新当前分类",
        "icon": "$(refresh)"
      },
      {
        "command": "marketlens.toggleMask",
        "title": "切换简洁展示模式",
        "icon": "$(eye)"
      },
      {
        "command": "marketlens.toggleBossKey",
        "title": "专注模式（一键隐藏/恢复）",
        "icon": "$(eye-closed)"
      },
      {
        "command": "marketlens.addItem",
        "title": "添加自选",
        "icon": "$(add)"
      },
      {
        "command": "marketlens.removeItem",
        "title": "删除",
        "icon": "$(trash)"
      },
      {
        "command": "marketlens.toggleColorNeutral",
        "title": "切换颜色脱敏模式",
        "icon": "$(paintcan)"
      },
      {
        "command": "marketlens.openKeybindings",
        "title": "自定义快捷键",
        "icon": "$(keyboard)"
      },
      {
        "command": "marketlens.openSettings",
        "title": "设置",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "marketlens.toggleBossKey",
        "key": "ctrl+alt+m",
        "win": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "marketlens.toggleBossKey",
        "key": "alt+m",
        "win": "alt+m"
      },
      {
        "command": "marketlens.toggleMask",
        "key": "ctrl+alt+k",
        "win": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "marketlens.toggleMask",
        "key": "alt+k",
        "win": "alt+k"
      },
      {
        "command": "marketlens.toggleColorNeutral",
        "key": "ctrl+alt+c",
        "win": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "marketlens.toggleColorNeutral",
        "key": "alt+c",
        "win": "alt+c"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "marketlens.openSettings",
          "when": "view == marketlens.watchlist",
          "group": "navigation@1"
        },
        {
          "command": "marketlens.refresh",
          "when": "view == marketlens.watchlist",
          "group": "navigation@2"
        },
        {
          "command": "marketlens.toggleBossKey",
          "when": "view == marketlens.watchlist",
          "group": "navigation@3"
        },
        {
          "command": "marketlens.toggleMask",
          "when": "view == marketlens.watchlist",
          "group": "navigation@4"
        },
        {
          "command": "marketlens.addItem",
          "when": "view == marketlens.watchlist",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "marketlens.refreshGroup",
          "when": "view == marketlens.watchlist && viewItem == groupItem",
          "group": "inline"
        },
        {
          "command": "marketlens.removeItem",
          "when": "view == marketlens.watchlist && viewItem == stockItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "MarketLens",
      "properties": {
        "marketlens.autoRefresh": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "【全局】是否开启定时自动刷新（取消勾选则不自动刷新，仅在手动点击刷新按钮时更新）"
        },
        "marketlens.refreshInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "maximum": 300000,
          "order": 2,
          "description": "【全局】定时刷新间隔（毫秒），如 5000 表示 5 秒"
        },
        "marketlens.maskMode": {
          "type": "boolean",
          "default": false,
          "order": 3,
          "description": "【全局】紧凑展示模式：将行情数据展示为简洁构建信息格式"
        },
        "marketlens.colorNeutral": {
          "type": "boolean",
          "default": false,
          "order": 4,
          "description": "【全局】中性色彩模式：关闭红绿色彩标记，使用编辑器默认主题文本颜色"
        },
        "marketlens.aShare.enabled": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "description": "【A股板块】是否启用 A 股市场行情（取消勾选则在自选列表中隐藏 A 股）"
        },
        "marketlens.aShare.networkMode": {
          "type": "string",
          "enum": [
            "direct",
            "proxy"
          ],
          "enumDescriptions": [
            "直连访问（默认，腾讯接口境内推荐直连，零延迟）",
            "强制走代理"
          ],
          "default": "direct",
          "order": 11,
          "description": "【A股板块】网络访问模式：direct (直连，默认) 或 proxy (走代理)"
        },
        "marketlens.aShare.proxyUrl": {
          "type": "string",
          "default": "http://127.0.0.1:10808",
          "order": 12,
          "description": "【A股板块】代理地址"
        },
        "marketlens.aShare.stopOnMarketClosed": {
          "type": "boolean",
          "default": true,
          "order": 13,
          "description": "【A股板块】闭市期间停止轮询（开启后仅在 A 股交易时段 9:15-11:30, 13:00-15:05 请求数据）"
        },
        "marketlens.binance.enabled": {
          "type": "boolean",
          "default": true,
          "order": 20,
          "description": "【Binance板块】是否启用 Binance 主流加密货币行情"
        },
        "marketlens.binance.networkMode": {
          "type": "string",
          "enum": [
            "proxy",
            "direct"
          ],
          "enumDescriptions": [
            "通过代理服务器访问（推荐，适用于特定网络环境）",
            "直连访问，不走代理"
          ],
          "default": "proxy",
          "order": 21,
          "description": "【Binance板块】网络访问模式：proxy (走代理) 或 direct (直连)"
        },
        "marketlens.binance.proxyUrl": {
          "type": "string",
          "default": "http://127.0.0.1:10808",
          "order": 22,
          "description": "【Binance板块】代理地址（支持自动探测 10808, 10809, 7890, 7897, 2080, 1080 等本地端口）"
        },
        "marketlens.alpha.enabled": {
          "type": "boolean",
          "default": true,
          "order": 30,
          "description": "【Alpha板块】是否启用 Alpha 链上代币行情（BSC、Solana、Base 等全链 DEX）"
        },
        "marketlens.alpha.networkMode": {
          "type": "string",
          "enum": [
            "proxy",
            "direct"
          ],
          "enumDescriptions": [
            "通过代理服务器访问（推荐，适用于特定网络环境）",
            "直连访问，不走代理"
          ],
          "default": "proxy",
          "order": 31,
          "description": "【Alpha板块】网络访问模式：proxy (走代理) 或 direct (直连)"
        },
        "marketlens.alpha.proxyUrl": {
          "type": "string",
          "default": "http://127.0.0.1:10808",
          "order": 32,
          "description": "【Alpha板块】代理地址（支持自动探测主流代理客户端端口）"
        },
        "marketlens.watchlist": {
          "type": "object",
          "order": 99,
          "description": "自选列表配置，按分组组织",
          "default": {
            "A股": [
              {
                "symbol": "sh688584",
                "name": "上海合晶",
                "type": "A_SHARE"
              },
              {
                "symbol": "sh600030",
                "name": "中信证券",
                "type": "A_SHARE"
              },
              {
