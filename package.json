				},
				"marketlens.usStock.statusBar": {
					"type": "boolean",
					"default": true,
					"order": 44,
					"description": "【美股板块】美股标的是否参与底部状态栏轮播"
				},
				"marketlens.binance.enabled": {
					"type": "boolean",
