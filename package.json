{
	"name": "marketlens",
	"displayName": "MarketLens-全球行情看板(A股/港股/美股/基金/加密货币)",
	"description": "实时查看A股/港股/美股/基金/加密货币与链上DEX资产，支持快捷键隐藏、简洁模式及网络代理。专为开发者打造的摸鱼盯盘与股票看板效率工具，支持自定义自选列表、价格预警、底部状态栏轮播。",
	"version": "1.1.9",
	"publisher": "devqqqqq",
	"repository": {
		"type": "git",
		"url": "https://github.com/DevQQQQQ/MarketLens"
	},
	"bugs": {
		"url": "https://github.com/DevQQQQQ/MarketLens/issues"
	},
	"homepage": "https://github.com/DevQQQQQ/MarketLens",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "assets/icon.png",
	"categories": [
		"Other",
		"Visualization"
	],
	"keywords": [
		"A股",
		"港股",
		"美股",
		"股票",
		"行情看板",
		"摸鱼",
		"盯盘",
		"加密货币",
		"炒币",
		"区块链",
		"实时行情",
		"crypto",
		"stock",
		"stocks",
		"binance",
		"dex",
		"tracker",
		"finance",
		"cryptocurrency",
		"quote",
		"ticker",
		"dashboard",
		"基金",
		"ETF",
		"场内基金",
		"fund",
		"etf"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "marketlens-container",
					"title": "%viewsContainers.title%",
					"icon": "assets/icon.svg"
				}
			]
		},
		"views": {
			"marketlens-container": [
				{
					"id": "marketlens.watchlist",
					"name": "%views.watchlist.name%",
					"icon": "assets/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "marketlens.refresh",
				"title": "%command.refresh%",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.refreshGroup",
				"title": "%command.refreshGroup%",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.expandAllGroups",
				"title": "%command.expandAllGroups%",
				"icon": "$(expand-all)"
			},
			{
				"command": "marketlens.sortGroup",
				"title": "%command.sortGroup%",
				"icon": "$(list-ordered)"
			},
			{
				"command": "marketlens.toggleMask",
				"title": "%command.toggleMask%",
				"icon": "$(eye)"
			},
			{
				"command": "marketlens.toggleBossKey",
				"title": "%command.toggleBossKey%",
				"icon": "$(eye-closed)"
			},
			{
				"command": "marketlens.addItem",
				"title": "%command.addItem%",
				"icon": "$(add)"
			},
			{
				"command": "marketlens.removeItem",
				"title": "%command.removeItem%",
				"icon": "$(trash)"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"title": "%command.toggleColorNeutral%",
				"icon": "$(paintcan)"
			},
			{
				"command": "marketlens.openKeybindings",
				"title": "%command.openKeybindings%",
				"icon": "$(keyboard)"
			},
			{
				"command": "marketlens.openSettings",
				"title": "%command.openSettings%",
				"icon": "$(gear)"
			},
			{
				"command": "marketlens.restoreDefaults",
				"title": "%command.restoreDefaults%",
				"icon": "$(discard)"
			},
			{
				"command": "marketlens.clearWatchlist",
				"title": "%command.clearWatchlist%",
				"icon": "$(clear-all)"
			},
			{
				"command": "marketlens.pinToTop",
				"title": "%command.pinToTop%",
				"icon": "$(pin)"
			},
			{
				"command": "marketlens.setAlert",
				"title": "%command.setAlert%",
				"icon": "$(bell)"
			},
			{
				"command": "marketlens.showLogs",
				"title": "%command.showLogs%",
				"icon": "$(output)"
			}
		],
		"keybindings": [
			{
				"command": "marketlens.toggleBossKey",
				"key": "ctrl+alt+m",
				"win": "ctrl+alt+m",
				"mac": "cmd+alt+m"
			},
			{
				"command": "marketlens.toggleBossKey",
				"key": "alt+m",
				"win": "alt+m",
				"mac": "alt+m"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "ctrl+alt+k",
				"win": "ctrl+alt+k",
				"mac": "cmd+alt+k"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "alt+k",
				"win": "alt+k",
				"mac": "alt+k"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "ctrl+alt+l",
				"win": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "alt+l",
				"win": "alt+l",
				"mac": "alt+l"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "marketlens.openSettings",
					"when": "view == marketlens.watchlist",
					"group": "navigation@1"
				},
				{
					"command": "marketlens.refresh",
					"when": "view == marketlens.watchlist",
					"group": "navigation@2"
				},
				{
					"command": "marketlens.toggleBossKey",
					"when": "view == marketlens.watchlist",
					"group": "navigation@3"
				},
				{
					"command": "marketlens.toggleMask",
					"when": "view == marketlens.watchlist",
					"group": "navigation@4"
				},
				{
					"command": "marketlens.addItem",
					"when": "view == marketlens.watchlist",
					"group": "navigation@5"
				},
				{
					"command": "marketlens.expandAllGroups",
					"when": "view == marketlens.watchlist",
					"group": "navigation@6"
				}
			],
			"view/item/context": [
				{
					"command": "marketlens.sortGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "inline@1"
				},
				{
					"command": "marketlens.refreshGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "inline@2"
				},
				{
					"command": "marketlens.sortGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "1_group@1"
				},
				{
					"command": "marketlens.refreshGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "1_group@2"
				},
				{
					"command": "marketlens.setAlert",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@1"
				},
				{
					"command": "marketlens.removeItem",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@2"
				},
				{
					"command": "marketlens.pinToTop",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "2_manage@1"
				}
			]
		},
		"configuration": {
			"title": "MarketLens",
			"properties": {
				"marketlens.autoRefresh": {
					"type": "boolean",
					"default": true,
					"order": 1,
					"description": "【全局】是否开启定时自动刷新（取消勾选则不自动刷新，仅在手动点击刷新按钮时更新）"
				},
				"marketlens.refreshInterval": {
					"type": "number",
					"default": 5000,
					"minimum": 1000,
					"maximum": 300000,
					"order": 2,
					"description": "【全局】定时刷新间隔（毫秒），如 5000 表示 5 秒"
				},
				"marketlens.maskMode": {
					"type": "boolean",
					"default": false,
					"order": 3,
					"description": "【全局】紧凑展示模式：将行情数据展示为简洁构建信息格式"
				},
				"marketlens.colorNeutral": {
					"type": "boolean",
					"default": false,
					"order": 4,
					"description": "【全局】中性色彩模式：关闭红绿色彩标记，使用编辑器默认主题文本颜色"
				},
				"marketlens.colorScheme": {
					"type": "string",
					"enum": [
						"greenUpRedDown",
						"redUpGreenDown"
					],
					"enumDescriptions": [
						"绿涨红跌（国际/加密/美股习惯，默认）",
						"红涨绿跌（A股/国内传统金融盘面习惯）"
					],
					"default": "greenUpRedDown",
					"order": 5,
					"description": "【全局】涨跌配色习惯：greenUpRedDown (绿涨红跌，默认) 或 redUpGreenDown (红涨绿跌)"
				},
				"marketlens.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"order": 6,
					"description": "【全局】全部标的参与底部轮播：是否在底部状态栏轮播展示行情（关闭后彻底隐藏底部状态栏）"
				},
				"marketlens.autoCollapseClosedGroups": {
					"type": "boolean",
					"default": true,
					"order": 7,
					"description": "【休市管理】休市时左侧看板分组自动折叠收起，且底部状态栏停止轮播休市标的（全休市时状态栏静默隐藏）"
				},
				"marketlens.proxyPort": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"default": 10808,
					"order": 8,
					"description": "【全局】本地代理端口号（1-65535，默认 10808。未配置时自适应读取系统 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY 或常用代理端口）"
				},
				"marketlens.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 9,
					"description": "【全局】统一代理地址（仅支持 HTTP / 混合代理。未配置时自动感知系统代理环境变量或自动探测工作代理）"
				},
				"marketlens.fund.enabled": {
					"type": "boolean",
					"default": true,
					"order": 10,
					"description": "【基金板块】是否启用基金与场内 ETF 行情（取消勾选则在自选列表中隐藏基金）"
				},
				"marketlens.fund.networkMode": {
					"type": "string",
					"enum": [
						"direct",
						"proxy"
					],
					"enumDescriptions": [
						"直连访问（默认，腾讯接口境内推荐直连，零延迟）",
						"强制走代理"
					],
					"default": "direct",
					"order": 11,
					"description": "【基金板块】网络访问模式：direct (直连，默认) 或 proxy (走代理)"
				},
				"marketlens.fund.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 12,
					"description": "【基金板块】代理地址"
				},
				"marketlens.fund.stopOnMarketClosed": {
					"type": "boolean",
					"default": true,
					"order": 13,
					"description": "【基金板块】闭市期间停止轮询（开启后仅在基金与 A 股交易时段 9:15-11:30, 13:00-15:05 请求数据）"
				},
				"marketlens.fund.statusBar": {
					"type": "boolean",
					"default": true,
					"order": 14,
					"description": "【基金板块】基金标的是否参与底部状态栏轮播"
				},
				"marketlens.aShare.enabled": {
					"type": "boolean",
					"default": true,
					"order": 20,
					"description": "【A股板块】是否启用 A 股市场行情（取消勾选则在自选列表中隐藏 A 股）"
				},
				"marketlens.aShare.networkMode": {
					"type": "string",
					"enum": [
						"direct",
						"proxy"
					],
					"enumDescriptions": [
						"直连访问（默认，腾讯接口境内推荐直连，零延迟）",
						"强制走代理"
					],
					"default": "direct",
					"order": 21,
					"description": "【A股板块】网络访问模式：direct (直连，默认) 或 proxy (走代理)"
				},
				"marketlens.aShare.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 22,
					"description": "【A股板块】代理地址"
				},
				"marketlens.aShare.stopOnMarketClosed": {
					"type": "boolean",
					"default": true,
					"order": 23,
					"description": "【A股板块】闭市期间停止轮询（开启后仅在 A 股交易时段 9:15-11:30, 13:00-15:05 请求数据）"
				},
				"marketlens.aShare.statusBar": {
					"type": "boolean",
					"default": true,
					"order": 24,
					"description": "【A股板块】A股标的是否参与底部状态栏轮播"
				},
				"marketlens.hkStock.enabled": {
					"type": "boolean",
					"default": true,
					"order": 30,
					"description": "【港股板块】是否启用港股行情（取消勾选则在自选列表中隐藏港股）"
				},
				"marketlens.hkStock.networkMode": {
					"type": "string",
					"enum": [
						"direct",
						"proxy"
					],
					"enumDescriptions": [
						"直连访问（默认，腾讯接口境内推荐直连，零延迟）",
						"强制走代理"
					],
					"default": "direct",
					"order": 31,
					"description": "【港股板块】网络访问模式：direct (直连，默认) 或 proxy (走代理)"
