                "type": "A_SHARE"
              },
              {
                "symbol": "sz301293",
                "name": "三博脑科",
                "type": "A_SHARE"
              }
            ],
            "Binance": [
              {
                "symbol": "BTCUSDT",
                "name": "BTC/USDT",
                "type": "CRYPTO"
              },
              {
                "symbol": "ETHUSDT",
                "name": "ETH/USDT",
