				},
				"marketlens.hkStock.stopOnMarketClosed": {
					"type": "boolean",
					"default": true,
					"order": 33,
					"description": "【港股板块】闭市期间停止轮询（开启后仅在港股交易时段 9:30-12:00, 13:00-16:10 请求数据）"
